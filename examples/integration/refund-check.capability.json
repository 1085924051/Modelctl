{
  "id": "refund-check",
  "version": "1.0.0",
  "name": "Refund request check",
  "description": "Decide whether a customer message asks for a refund.",
  "model": {
    "model_id": "convaiinnovations/laya",
    "variant": "english",
    "profile": "auto"
  },
  "input": {
    "type": "object",
    "fields": {
      "text": { "type": "string", "required": true, "description": "Customer message" },
      "order_id": { "type": "string", "required": false, "description": "Order number" }
    },
    "template": "Customer message: {{text}}\nOrder: {{order_id}}"
  },
  "questions": {
    "refund": {
      "type": "noul",
      "instructions": "Does the customer explicitly ask for a refund?"
    },
    "team": {
      "type": "choice",
      "instructions": "Which team should handle this message?",
      "criteria": {
        "billing": "payments, refunds, and charges",
        "support": "technical help and account access"
      }
    }
  }
}
